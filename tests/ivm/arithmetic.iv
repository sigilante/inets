// The arithmetic and comparison functions, and a branch: prints ABCDEFGHJK, six digits, and Z.
iv:main {
  ^ = ivm:x(io0 io17)
  ivm:n32#60 = ivm:ext:merge[vi:n32:add](ivm:n32#5 c0)
  io0 = ivm:ext:merge[root:io:print_char](c0 io1)
  ivm:n32#70 = ivm:ext:merge[vi:n32:sub](ivm:n32#4 c1)
  io1 = ivm:ext:merge[root:io:print_char](c1 io2)
  ivm:n32#67 = ivm:ext:merge[vi:n32:mul](ivm:n32#1 c2)
  io2 = ivm:ext:merge[root:io:print_char](c2 io3)
  ivm:n32#136 = ivm:ext:merge[vi:n32:div](ivm:n32#2 c3)
  io3 = ivm:ext:merge[root:io:print_char](c3 io4)
  ivm:n32#169 = ivm:ext:merge[vi:n32:rem](ivm:n32#100 c4)
  io4 = ivm:ext:merge[root:io:print_char](c4 io5)
  ivm:n32#127 = ivm:ext:merge[vi:n32:and](ivm:n32#70 c5)
  io5 = ivm:ext:merge[root:io:print_char](c5 io6)
  ivm:n32#64 = ivm:ext:merge[vi:n32:or](ivm:n32#7 c6)
  io6 = ivm:ext:merge[root:io:print_char](c6 io7)
  ivm:n32#104 = ivm:ext:merge[vi:n32:xor](ivm:n32#32 c7)
  io7 = ivm:ext:merge[root:io:print_char](c7 io8)
  ivm:n32#37 = ivm:ext:merge[vi:n32:shl](ivm:n32#1 c8)
  io8 = ivm:ext:merge[root:io:print_char](c8 io9)
  ivm:n32#150 = ivm:ext:merge[vi:n32:shr](ivm:n32#1 c9)
  io9 = ivm:ext:merge[root:io:print_char](c9 io10)
  ivm:n32#1 = ivm:ext:merge[vi:n32:eq](ivm:n32#1 r10)
  r10 = ivm:ext:merge[vi:n32:add](ivm:n32#48 c10)
  io10 = ivm:ext:merge[root:io:print_char](c10 io11)
  ivm:n32#1 = ivm:ext:merge[vi:n32:ne](ivm:n32#1 r11)
  r11 = ivm:ext:merge[vi:n32:add](ivm:n32#48 c11)
  io11 = ivm:ext:merge[root:io:print_char](c11 io12)
  ivm:n32#1 = ivm:ext:merge[vi:n32:lt](ivm:n32#2 r12)
  r12 = ivm:ext:merge[vi:n32:add](ivm:n32#48 c12)
  io12 = ivm:ext:merge[root:io:print_char](c12 io13)
  ivm:n32#3 = ivm:ext:merge[vi:n32:le](ivm:n32#2 r13)
  r13 = ivm:ext:merge[vi:n32:add](ivm:n32#48 c13)
  io13 = ivm:ext:merge[root:io:print_char](c13 io14)
  ivm:n32#4294967295 = ivm:ext:merge[vi:n32:add_high](ivm:n32#1 r14)
  r14 = ivm:ext:merge[vi:n32:add](ivm:n32#48 c14)
  io14 = ivm:ext:merge[root:io:print_char](c14 io15)
  ivm:n32#65536 = ivm:ext:merge[vi:n32:mul_high](ivm:n32#65536 r15)
  r15 = ivm:ext:merge[vi:n32:add](ivm:n32#48 c15)
  io15 = ivm:ext:merge[root:io:print_char](c15 io16)
  ivm:n32#1 = ivm:ext:merge[ivm:branch](ivm:branch[:first, :second] g)
  g = ivm:ext:merge[vi:n32:add](ivm:n32#0 c16)
  io16 = ivm:ext:merge[root:io:print_char](c16 io17)
}

:first { ^ = ivm:n32#89 }
:second { ^ = ivm:n32#90 }
