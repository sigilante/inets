// A function node copied by a combinator: 1 + 64 and 2 + 64, printed as characters.
iv:main {
  ^ = ivm:x(io0 io2)
  ivm:y(f g) = ivm:ext:merge[vi:n32:sub](a b)
  a = ivm:n32#3
  f = ivm:n32#68
  g = ivm:n32#69
  b = ivm:y(o1 o2)
  io0 = ivm:ext:merge[root:io:print_char](o1 io1)
  io1 = ivm:ext:merge[root:io:print_char](o2 io2)
}
