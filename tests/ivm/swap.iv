// A merge written with its arguments exchanged, its first argument late: 7 - 3 is
// printed as a character after 60 is added.
iv:main {
  ^ = ivm:x(io0 io1)
  ivm:n32#3 = ivm:ext:merge:swap[vi:n32:sub](seven d)
  ivm:graft[:seven] = seven
  d = ivm:ext:merge[vi:n32:add](ivm:n32#60 c)
  io0 = ivm:ext:merge[root:io:print_char](c io1)
}
:seven { ^ = ivm:n32#7 }
